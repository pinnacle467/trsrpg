# --- The Realm Survivor RPG | Apache config for Hostinger ---

# 1) SPA fallback so React Router deep links (/media, /support, /pimps) don't 404
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 2) Correct MIME types (defensive — Hostinger usually sets these, but doesn't hurt)
<IfModule mod_mime.c>
  AddType application/javascript           .js
  AddType text/css                          .css
  AddType image/svg+xml                     .svg
  AddType image/webp                        .webp
  AddType video/mp4                         .mp4
  AddType application/json                  .json
</IfModule>

# 3) Force HTTPS (in case "Force HTTPS" toggle in hPanel is off)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 4) Aggressive caching for hashed static assets, no-cache for index.html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # index.html should always be revalidated so deploys show up immediately
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# 5) gzip / brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
